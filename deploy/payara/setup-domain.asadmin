create-jdbc-connection-pool --datasourceclassname com.mysql.cj.jdbc.MysqlDataSource --restype javax.sql.DataSource --property user=globaltrade_app:password=${ALIAS=globaltrade.db.password}:serverName=localhost:portNumber=3306:databaseName=globaltrade_logistics:useSSL=false:allowPublicKeyRetrieval=true globaltradePool
create-jdbc-resource --connectionpoolid globaltradePool jdbc/globaltradeDS
create-auth-realm --classname com.sun.enterprise.security.auth.realm.jdbc.JDBCRealm --login-module com.hiru.globaltrade.security.jaas.SupplyChainLoginModule --property jaas-context=globaltradeSupplyChainRealm:datasource-jndi=jdbc/globaltradeDS:user-table=auth_users:user-name-column=username:password-column=password_hash:group-table=auth_user_roles:group-name-column=role_name:digest-algorithm=none:auth.user.table=auth_users:auth.role.table=auth_user_roles globaltradeRealm
