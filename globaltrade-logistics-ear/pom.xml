<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hiru</groupId>
        <artifactId>globaltrade-logistics</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>globaltrade-logistics-ear</artifactId>
    <packaging>ear</packaging>
    <name>GlobalTrade Logistics EAR</name>

    <dependencies>
        <dependency>
            <groupId>com.hiru</groupId>
            <artifactId>globaltrade-logistics-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hiru</groupId>
            <artifactId>globaltrade-logistics-ejb</artifactId>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>com.hiru</groupId>
            <artifactId>globaltrade-logistics-web</artifactId>
            <type>war</type>
        </dependency>
    </dependencies>

    <build>
        <finalName>globaltrade-logistics</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <configuration>
                    <modules>
                        <jarModule>
                            <groupId>com.hiru</groupId>
                            <artifactId>globaltrade-logistics-common</artifactId>
                            <bundleDir>lib</bundleDir>
                        </jarModule>
                        <ejbModule>
                            <groupId>com.hiru</groupId>
                            <artifactId>globaltrade-logistics-ejb</artifactId>
                            <bundleFileName>globaltrade-logistics-ejb.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>com.hiru</groupId>
                            <artifactId>globaltrade-logistics-web</artifactId>
                            <contextRoot>/globaltrade</contextRoot>
                            <bundleFileName>globaltrade-logistics-web.war</bundleFileName>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>arquillian-payara</id>
            <properties>
                <globaltrade.it.password></globaltrade.it.password>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.arquillian.junit5</groupId>
                    <artifactId>arquillian-junit5-container</artifactId>
                    <version>${arquillian.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>fish.payara.arquillian</groupId>
                    <artifactId>arquillian-payara-server-remote</artifactId>
                    <version>${payara.arquillian.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.shrinkwrap</groupId>
                    <artifactId>shrinkwrap-api</artifactId>
                    <version>1.2.6</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.assertj</groupId>
                    <artifactId>assertj-core</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-integration-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/it/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-integration-test-resources</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>add-test-resource</goal>
                                </goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <directory>src/it/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <globaltrade.it.adminUser>admin</globaltrade.it.adminUser>
                                <globaltrade.it.adminPassword>${globaltrade.it.password}</globaltrade.it.adminPassword>
                                <globaltrade.it.coordinatorUser>coordinator</globaltrade.it.coordinatorUser>
                                <globaltrade.it.coordinatorPassword>${globaltrade.it.password}</globaltrade.it.coordinatorPassword>
                                <globaltrade.it.warehouseUser>warehouse</globaltrade.it.warehouseUser>
                                <globaltrade.it.warehousePassword>${globaltrade.it.password}</globaltrade.it.warehousePassword>
                                <globaltrade.it.customsUser>customs</globaltrade.it.customsUser>
                                <globaltrade.it.customsPassword>${globaltrade.it.password}</globaltrade.it.customsPassword>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
