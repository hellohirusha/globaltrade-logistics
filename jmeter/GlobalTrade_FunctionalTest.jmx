      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Prepare unique test data" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Base64
vars.put('authHeader', 'Basic ' + Base64.encoder.encodeToString((vars.get('username') + ':' + vars.get('password')).getBytes('UTF-8')))
def iteration = vars.getIteration()
def suffix = System.currentTimeMillis().toString() + '-' + ctx.getThreadNum() + '-' + iteration
vars.put('shipmentRef', 'GTL-JMX-' + suffix)
vars.put('vendorCode', 'VEN-JMX-' + suffix)
vars.put('sku', 'JMX-SKU-' + suffix)
vars.put('warehouseCode', 'JMX-WH-' + ctx.getThreadNum())
vars.put('estimatedDelivery', java.time.LocalDateTime.now().plusDays(5).withNano(0).toString())
vars.put('stockQty', String.valueOf(40 + ctx.getThreadNum() + iteration))
vars.put('reorderPoint', '15')
vars.put('reorderQuantity', '80')
vars.put('sharedStockQty', String.valueOf(30 + ((ctx.getThreadNum() + iteration) % 70)))
vars.put('onTimeScore', String.valueOf(70 + ((ctx.getThreadNum() + iteration) % 25)))
vars.put('complianceScore', String.valueOf(72 + ((ctx.getThreadNum() + iteration) % 20)))
vars.put('disruptionScore', String.valueOf(10 + ((ctx.getThreadNum() + iteration) % 30)))</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
